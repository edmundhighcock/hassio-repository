# See the repository edmundhighcock/hass-taiga
# in the folder build to see what is in this image
#
# Per-architecture Dockerfile (amd64). Since Supervisor 2026.04.0 the
# BUILD_FROM build arg is no longer passed unless a (deprecated) build.yaml
# is present, so `ARG BUILD_FROM` / `FROM $BUILD_FROM` is no longer reliable.
# This repo pins two genuinely different upstream images per architecture,
# so the documented replacement is a fixed FROM in a per-arch Dockerfile
# named Dockerfile.<arch>, which the Supervisor picks up instead of a
# plain Dockerfile. See:
#   https://contributors.home-assistant.io/apps/guides/dockerfile/#build-arguments
#   https://contributors.home-assistant.io/apps/guides/dockerfile/#buildyaml
FROM edmundhighcock/hass-taiga:withjq

USER root

# RUN apt-get update && apt-get install -y vim-tiny
USER taiga
COPY backend_config.py /home/taiga/taiga-back/settings/config.py
COPY frontend-conf.json /home/taiga/taiga-front-dist/dist/conf.json

USER root
COPY start.sh /start.sh
COPY migrate.sh /migrate.sh
COPY run.sh /run.sh
COPY init_postgres.sh /init_postgres.sh
COPY backup.sh /backup.sh
COPY taiga.sql /taiga.sql
COPY nginx.conf /etc/nginx/conf.d/taiga.conf
RUN chown taiga /migrate.sh /run.sh /init_postgres.sh /taiga.sql /backup.sh
CMD bash /start.sh
# CMD sleep 200d
# USER taiga
